# ===== Search Service =====

# Network
SEARCH_SERVICE_HOST=0.0.0.0
SEARCH_SERVICE_PORT=8003
SEARCH_SERVICE_RELOAD=false
SEARCH_SERVICE_LOG_LEVEL=info

# LLM — point at the gateway, not OpenAI directly
OPENAI_BASE_URL=http://localhost:8002/v1
OPENAI_API_KEY=your-gateway-api-key
OPENAI_LLM_MODEL=gpt-4.1-nano
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-large
TEMPERATURE=0.1
MAX_TOKENS=10000

# Neo4j — direct connection (search service owns the graph queries)
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password
NEO4J_DATABASE=neo4j
NEO4J_MAX_POOL_SIZE=10
NEO4J_REFRESH_SCHEMA=false
AURA_INSTANCEID=your-aura-instance-id
AURA_INSTANCENAME=Free instance

# Cache — local (default) or upstash
CACHE_BACKEND=upstash
CACHE_EMBEDDING_PROVIDER=sentence_transformer

# Upstash Redis (required when CACHE_BACKEND=upstash)
# Get these from https://console.upstash.com → Redis → your database → REST API
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# Upstash Vector (required when CACHE_BACKEND=upstash)
# Get these from https://console.upstash.com → Vector → your index → REST API
UPSTASH_VECTOR_REST_URL=https://your-index.upstash.io
UPSTASH_VECTOR_REST_TOKEN=your-vector-token

# Optional Upstash tuning
# UPSTASH_CACHE_TTL=604800        # cache TTL in seconds (default: 7 days)
