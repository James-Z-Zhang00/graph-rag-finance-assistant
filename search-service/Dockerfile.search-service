FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
    && rm -rf /var/lib/apt/lists/*

COPY search-service/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Download sentence-transformer model at build time into the same path
# that MODEL_CACHE_DIR resolves to at runtime (/app/cache/model)
# This prevents Cloud Run from hitting HuggingFace at runtime
RUN mkdir -p /app/cache/model && \
    python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2', cache_folder='/app/cache/model')"

# Download spaCy NER model at build time — required by Presidio for PERSON_NAME
# and STREET_ADDRESS detection. Baking it in prevents a 560 MB runtime download.
RUN python -m spacy download en_core_web_lg

COPY search-service/ .

EXPOSE 8003

CMD ["python", "main.py"]
